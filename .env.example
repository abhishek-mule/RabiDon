# RabiDon local-first configuration (no paid LLM dependency required)

# Core
RABIDON_ENV=development
RABIDON_DB_PATH=./data/rabidon.db
RABIDON_DATA_DIR=./data
RABIDON_OUTPUT_DIR=./output
RABIDON_LOG_LEVEL=INFO

# TTS (ADR-009: voice unresolved until selection+licence spike)
RABIDON_TTS_PROVIDER=recorded   # piper | recorded (use recorded until spike completes)
RABIDON_PIPER_BIN=
RABIDON_VOICE_ID=
RABIDON_VOICE_MODEL_PATH=
RABIDON_VOICE_LICENCE_REF=
RABIDON_PRONUNCIATION_DICT=

# Telegram approvals (exact-action; external preview requires sharing permission, ADR-005)
RABIDON_TELEGRAM_BOT_TOKEN=
RABIDON_TELEGRAM_APPROVER_CHAT_ID=
RABIDON_TELEGRAM_ALLOWED_USER_IDS=

# YouTube (private-first; separate public-release approval, ADR-004/007)
RABIDON_YOUTUBE_CLIENT_ID=
RABIDON_YOUTUBE_CLIENT_SECRET=
RABIDON_YOUTUBE_REFRESH_TOKEN=
RABIDON_YOUTUBE_DEFAULT_PRIVACY=private

# Optional AI (rules/manual fallback must remain viable, ADR-006)
RABIDON_AI_PROVIDER_ORDER=rules
RABIDON_AI_TIMEOUT_SECONDS=30
